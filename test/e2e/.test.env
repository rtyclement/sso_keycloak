# ─── Module sso_keycloak (lu par les serveurs Node) ───────────────────────────
KEYCLOAK_AUTH_URL="http://localhost:8080/auth"
KEYCLOAK_REALM="test-realm"
KEYCLOAK_CLIENT_ID="test-client"
KEYCLOAK_CLIENT_SECRET="test-client-secret"
KEYCLOAK_REDIRECT_URI="http://localhost:9090/callback"
SESSION_SECRET="dev-only-session-secret-please-change-0123456789abcdef"
KEYCLOAK_ALLOW_HTTP="true"

# Port unique sur lequel le serveur Node (express OU fastify) écoute.
# Doit correspondre au port de KEYCLOAK_REDIRECT_URI ci-dessus.
APP_PORT="9090"

# ─── Utilisateur de test (présent dans le realm importé) ──────────────────────
TEST_USERNAME="testuser"
TEST_PASSWORD="testpassword"

# Utilisateur authentifié MAIS sans rôle d'accès (doit recevoir 403)
TEST_USERNAME_NOACCESS="testuser2"
TEST_PASSWORD_NOACCESS="testpassword2"

# ─── Admin bootstrap Keycloak (console, non utilisé par les tests) ────────────
KC_BOOTSTRAP_ADMIN_USERNAME="admin"
KC_BOOTSTRAP_ADMIN_PASSWORD="admin"
